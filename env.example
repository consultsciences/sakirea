# Sakirea configuration (all optional)

# --- LLM mode -------------------------------------------------------------
# With no key set, Sakirea runs in deterministic mode: it synthesizes the
# artifact directly from source results and labels it
# "mode: deterministic (no LLM key)".
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Model selection (optional; resolved through src/model/registry.ts)
# SAKIREA_MODEL=gpt-4o-mini
# SAKIREA_MODEL=claude-sonnet

# Local OpenAI-compatible endpoint (Ollama); no key required.
# SAKIREA_OLLAMA_URL=http://localhost:11434/v1

# --- Paths ----------------------------------------------------------------
# Directory holding settings.json (default: ~/.sakirea)
# SAKIREA_HOME=/tmp/sakirea-home

# --- Source connectors (all key-free by default) --------------------------
# Optional; the connectors work without any of these.
# CROSSREF_MAILTO=you@example.com
# OPENALEX_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=
# HF_TOKEN=

# --- Telemetry ------------------------------------------------------------
# Sakirea has no telemetry of any kind. There is nothing to configure.
